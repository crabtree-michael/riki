# Riki environment configuration.
#
# Copy to `.env` and fill in what you need:  cp .env.example .env
# `pnpm setup` does this for you if `.env` is missing.
#
# `.env` is gitignored and must stay that way. Every variable here is read in exactly one
# place — `packages/config`, in the Electron main process — and injected everywhere else
# (REPO_SKELETON.md §6.2, §7). No real values belong in this file.
#
# Every variable below also has a CLI flag, named mechanically from the field it sets:
# `--gsi-port`, `--realtime-model`, `--no-privacy-unprompted`. Flags win over the environment,
# which wins over `settings.json` in the app's data directory, which wins over the defaults.
# `RIKI_OPENAI_API_KEY` is the one exception and has no flag — see below.

# --- OpenAI (alpha/beta: your own key, your own .env — see REPO_SKELETON.md §7.1) ---
RIKI_OPENAI_API_KEY=            # your own key. Required only for live voice; leave blank to
                                # run fixtures-only. Read by packages/config in the main
                                # process and nowhere else — deliberately not settable by a
                                # CLI flag (visible in the process list) or by settings.json
                                # (a file that is neither gitignored nor redacted).
                                # Never commit a filled-in .env.

# --- Realtime ---
RIKI_REALTIME_MODEL=gpt-realtime-2.1-mini   # mini by default; cost lever, realtime research §10
RIKI_REALTIME_VOICE=marin
RIKI_REALTIME_TRANSPORT=webrtc              # webrtc | websocket
RIKI_REALTIME_BUDGET_USD=                   # soft ceiling per session; blank uses the default

# --- Audio ---
RIKI_AUDIO_INPUT_DEVICE=        # blank is the system default microphone
RIKI_AUDIO_PRE_ROLL_MS=200      # audio kept from before the key press (voice-input §3.3).
                                # Pure added latency on every utterance; 0 disables it.

# --- Dota integration ---
RIKI_GSI_PORT=53101
RIKI_GSI_TOKEN=                 # generated per-install on first run; not a secret to share
                                # across machines, but never committed
RIKI_DOTA_PATH=                 # auto-detected; override for non-standard Steam installs
RIKI_LOG_TAIL_PATH=             # Dota's console.log; blank disables the source. The game
                                # writes it only when launched with -conclearlog
RIKI_LOG_TAIL_POLL_MS=250

# --- Coaching ---
# There is deliberately no RIKI_COACH. *Which* coach runs is the tray's Coach row, persisted to
# settings.json (ADR-0031): a variable left in a shell profile would silently undo the choice the
# player made in the menu on every restart, and a UI control a stale variable can override is not a
# control. A model *id* is not a mode, which is why the line below exists and that one does not.
RIKI_COACH_MODEL=               # blank uses packages/coach's own default tier

# --- Feature flags / degradation ---
RIKI_VISION=off                 # on | off — off runs GSI-only (state capture design §9).
                                # Off by default until a platform capture backend exists:
                                # riki-vision exits immediately, so `on` would cost every
                                # launch ten supervisor restarts to discover that (ADR-0030)
RIKI_VISION_BINARY=             # absolute path to the riki-vision binary; unused while off
RIKI_HOTKEY_TALK=Control+`      # Electron accelerator syntax (ui-design §6.3)
RIKI_LOG_LEVEL=info             # error | warn | info | debug | trace

# --- Privacy. All four must default off (REPO_SKELETON.md §7.2 rule 2), and a test asserts
#     each one separately. Turning one on here affects only your own machine. ---
RIKI_UNPROMPTED=off             # on | off — off is "only when I ask" mode, dota2 §6.4
RIKI_CAPTIONS=off               # ui-design §9.3
RIKI_CHAT_EGRESS=off            # Riki never types in Dota's chat
RIKI_DEBUG_FRAMES=off           # writes captured frames to disk for CV debugging

# --- Development ---
RIKI_REPLAY_FIXTURE=            # path to a fixtures/gsi/*.jsonl to drive a dev session
RIKI_FAKE_VISION=0              # 1 → FakeVisionSidecar instead of the Rust process. **Needs
                                # RIKI_VISION=on as well** — the two are orthogonal on purpose, so
                                # a development flag cannot switch a subsystem on by itself.
                                # Together they are the only configuration in which the vision leg
                                # runs anywhere today: the macOS backend has never been executed
                                # and the portable one has no atlas (ADR-0033, ADR-0035)
RIKI_DEBUG=off                  # on | off — the inspector window (docs/design/debug-inspector.md).
                                # Must default off: with it on the shell holds rendered snapshots,
                                # briefs and coach transcripts in memory, and evaluates all thirteen
                                # gates against every candidate rather than the winner alone.
                                # Until packages/config lands, set it in the app's settings.json
                                # instead — `{"debug": {"enabled": true}}` (main/bootstrap.ts).
