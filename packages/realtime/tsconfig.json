{
  "extends": "../../tsconfig.base.json",
  // `rootDir: "src"` and a flat `dist/`, exactly like the other nine packages — which is not
  // cosmetic. Electron main resolves this package through `exports.default` (`./dist/index.js`,
  // ADR-0025), and while `rootDir` was `"."` — to bring `test/` into a project ESLint could see —
  // the emit landed at `dist/src/index.js` and every runtime import of a *value* from here failed
  // with ERR_MODULE_NOT_FOUND. Nothing noticed for nine steps because main imported only types.
  //
  // `test/` now has its own project, `tsconfig.test.json`, which is what keeps ESLint's type-aware
  // rules able to lint it without pulling it into this one's output.
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../audio" }, { "path": "../protocol" }]
}
