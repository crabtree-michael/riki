{
  "extends": "../../tsconfig.base.json",
  // `rootDir: "src"`, like every other package, so the emit is flat: `dist/index.js` is what
  // `exports.default` promises and what Electron main actually loads (ADR-0025).
  //
  // This package is the only one with an integration-test directory outside `src/`, and an earlier
  // version claimed it here with `rootDir: "."`. That silently moved the output to `dist/src/` —
  // invisible to `tsc` and Vitest, which both read source through the `riki-source` condition, and
  // an `ERR_MODULE_NOT_FOUND` the first time the app booted. `test/tsconfig.json` claims those
  // files instead, which is the same split the repo-level `test/` project already uses.
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../audio" }]
}
