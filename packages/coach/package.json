{
  "name": "@riki/coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The LLM coach: an OpenAI agent that judges for itself when Riki should speak",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "riki-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "riki-source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@openai/agents": "^0.14.2",
    "@riki/context": "workspace:*",
    "@riki/events": "workspace:*",
    "@riki/world-model": "workspace:*",
    "zod": "^4.4.3"
  }
}
