{
  "name": "@riki/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Event engine: salience scoring, trigger policy, interrupt gates",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "riki-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "riki-source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@riki/context": "workspace:*",
    "@riki/world-model": "workspace:*"
  }
}
