{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Main-process integration tests and repo-level guards that read files off disk, so they get
  // Node types. Tests colocated in `src/` belong to whichever project owns that directory —
  // which is deliberate: a renderer test that reaches for `node:fs` should not compile.
  "extends": "./tsconfig.base.json",
  "include": ["test/**/*.ts"],
  "references": [{ "path": "./tsconfig.shared.json" }],
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"]
  }
}
